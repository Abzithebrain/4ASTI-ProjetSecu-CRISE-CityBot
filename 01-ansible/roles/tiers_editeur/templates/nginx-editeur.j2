log_format citybot_json escape=json '{'
  '"@timestamp":"$time_iso8601","source":{"ip":"$remote_addr"},'
  '"url":{"path":"$request_uri"},'
  '"http":{"request":{"method":"$request_method"},"response":{"status_code":$status,"bytes":$body_bytes_sent}},'
  '"service":{"name":"tiers-editeur-nginx"}}';
server {
    listen 443 ssl default_server;
    server_name tiers-editeur.citybot.lab;
    ssl_certificate     /etc/ssl/citybot/editeur.crt;
    ssl_certificate_key /etc/ssl/citybot/editeur.key;
    access_log {{ citybot_log_dir }}/tiers-editeur-nginx.json citybot_json;
    location / { proxy_pass http://127.0.0.1:8002; proxy_set_header X-Forwarded-For $remote_addr; }
}
