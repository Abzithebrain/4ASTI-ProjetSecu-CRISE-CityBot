log_format citybot_json escape=json '{'
  '"@timestamp":"$time_iso8601","source":{"ip":"$remote_addr"},'
  '"url":{"path":"$request_uri"},'
  '"http":{"request":{"method":"$request_method"},"response":{"status_code":$status}},'
  '"service":{"name":"tiers-paiement-nginx"}}';

server {
    listen 443 ssl default_server;
    server_name tiers-paiement.citybot.lab;
    ssl_certificate     /etc/ssl/citybot/paiement.crt;
    ssl_certificate_key /etc/ssl/citybot/paiement.key;
    access_log {{ citybot_log_dir }}/tiers-paiement-nginx.json citybot_json;
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
